{
  "name": "conexus",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run deps && npm run knip && npm run docs && npm run suppressions && npm run test && npm run build",
    "lint": "biome check .",
    "typecheck": "tsc -p scripts/tsconfig.json && tsc -p tests/e2e/tsconfig.json && npm run typecheck --workspaces --if-present",
    "deps": "depcruise . --config .dependency-cruiser.cjs",
    "knip": "knip",
    "docs": "node scripts/check-docs.ts",
    "suppressions": "node scripts/check-suppressions.ts",
    "approval": "node scripts/check-approval.ts",
    "method-freeze": "node scripts/check-method-freeze.ts",
    "new-dependencies": "node scripts/list-new-dependencies.ts",
    "migrations": "node scripts/check-migrations.ts",
    "removals": "node scripts/removals.ts",
    "radius": "node scripts/check-radius.ts",
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "pree2e": "npm exec -w @conexus/web -- playwright-core install chromium-headless-shell",
    "e2e": "node --test --test-timeout=300000 --test-reporter=./scripts/test-reporter.ts tests/e2e/*.test.ts",
    "test:scripts": "node --test --test-timeout=120000 --test-reporter=./scripts/test-reporter.ts scripts/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.2",
    "better-auth": "1.7.8",
    "dependency-cruiser": "18.4.0",
    "knip": "6.38.0",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "zod": "4.6.5"
  }
}
