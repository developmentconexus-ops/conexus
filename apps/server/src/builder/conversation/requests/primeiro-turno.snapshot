              "description": "New task status",
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed"
              ]
            },
            "activeForm": {
              "description": [
                "New present continuous form shown during execution",
                "constraints: minimum length 1"
              ],
              "type": "string"
            }
          },
          "required": [
