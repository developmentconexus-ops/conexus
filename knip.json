{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.ts", "tests/e2e/**/*.ts"],
      "ignoreBinaries": ["openssl"],
      "ignoreDependencies": [
        "jscpd",
        "agent-browser",
        "@mastra/core",
        "@mastra/memory",
        "@mastra/pg"
      ]
    },
    "apps/server": {
      "entry": ["src/**/*.check.ts"],
      "ignoreBinaries": ["setpriv"],
      "ignoreDependencies": [
        "@stryker-mutator/command-runner",
        "@conexus/app",
        "@mastra/e2b",
        "@mastra/fastify",
        "@mastra/server",
        "e2b",
        "@mastra/evals"
      ],
      "ignoreIssues": {
        "src/harness/model-accounts/**": ["exports", "types"]
      }
    },
    "apps/web": {
      "entry": ["src/ui/pieces-fixture.tsx"],
      "ignoreDependencies": [
        "@mastra/client-js",
        "mermaid",
        "react-markdown",
        "remark-gfm",
        "remend"
      ]
    },
    "packages/connectors": {
      "entry": ["scripts/*.ts"]
    },
    "packages/app": {
      "entry": ["src/**/*.check.ts", "src/check/program.ts"],
      "ignore": ["starter/**", "skills/**"],
      "ignoreDependencies": [
        "@hookform/resolvers",
        "@tanstack/react-table",
        "date-fns",
        "react-day-picker",
        "recharts"
      ]
    },
    "infra/aws": {
      "entry": ["bin/app.ts", "test/**/*.test.ts"]
    },
    "apps/edge": {
      "entry": ["clone/worker.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
