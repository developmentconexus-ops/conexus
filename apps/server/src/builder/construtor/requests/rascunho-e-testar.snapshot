            "name"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "agent_set",
        "description": "Changes the fields sent of an agent’s draft at the revision you read. On AGENT_DRAFT_STALE the answer carries the current draft: save again over it.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "constraints: minimum length 1, maximum length 80"
            },
            "description": {
              "type": "string",
              "description": "constraints: maximum length 280"
            },
            "instructions": {
              "type": "string",
              "description": "constraints: maximum length 8000"
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "constraints: minimum length 1, maximum length 200"
                },
                {
                  "type": "null"
                }
              ]
            },
            "memory": {
              "type": "object",
              "properties": {
                "observational": {
                  "type": "boolean"
                }
              },
              "required": [
                "observational"
              ],
              "additionalProperties": false
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "constraints: a valid uuid"
              },
              "description": "constraints: maximum length 50"
            },
            "web": {
              "type": "boolean"
            },
            "appData": {
              "type": "boolean"
            },
            "machine": {
              "type": "boolean"
            },
            "revision": {
              "type": "integer",
              "description": "constraints: greater than 0"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "constraints: a valid uuid"
              }
            },
            "ready": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "description": "constraints: a valid uuid"
                  },
                  "operation": {
                    "type": "string",
                    "description": "constraints: input must match this regex ^[a-z][a-zA-Z0-9]{1,39}$"
                  }
                },
                "required": [
                  "connectionId",
                  "operation"
                ],
                "additionalProperties": false
              },
              "description": "constraints: maximum length 50"
            },
            "approvals": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "description": "constraints: a valid uuid"
              },
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "ASK",
                  "AUTO"
                ]
              },
              "required": []
            },
            "agentId": {
              "type": "string",
              "description": "constraints: a valid uuid"
            }
          },
          "required": [
            "revision",
            "agentId"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "agent_test",
        "description": "Asks the agent’s draft one question and returns its answer and the tools it called. Nothing is kept.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string",
              "description": "constraints: a valid uuid"
            },
            "question": {
              "type": "string",
              "description": "constraints: minimum length 1, maximum length 2000"
            }
          },
          "required": [
            "agentId",
            "question"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "task_write",
        "description": [
          "Create and manage a structured task list for your current coding session. This helps you track progress, organize complex tasks, and demonstrate thoroughness to the user.",
          "",
          "Usage:",
          "- Use this to create the initial task list or replace the whole list after replanning",
          "- Pass the FULL task list each time this tool is called (replaces the previous list)",
          "- Each task has: id (stable identifier), content (imperative), status (pending, in_progress, or completed), activeForm (present continuous)",
          "- IDs must be unique. If duplicate explicit IDs are provided, the duplicate task is returned with a generated fallback ID",
          "- Keep task IDs stable across updates. If omitted, IDs are generated and returned in the tool result",
          "- When an ID is omitted while rewriting an existing list, one unambiguous matching task may reuse an existing ID",
          "- Prefer single-task update tools when they are available",
          "- Mark tasks in_progress BEFORE starting work (only ONE at a time)",
          "- Mark tasks completed IMMEDIATELY after finishing",
          "- Use this for multi-step tasks requiring 3+ distinct actions",
          "",
          "States:",
          "- pending: Not yet started",
          "- in_progress: Currently working on (limit to ONE)",
          "- completed: Finished successfully"
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": [
                      "Stable task identifier (for example, 'task_investigate_tests'). Keep this unchanged across updates.",
                      "constraints: minimum length 1"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "description": [
                      "Task description in imperative form (e.g., 'Fix authentication bug')",
                      "constraints: minimum length 1"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "in_progress",
                      "completed"
                    ],
                    "description": "Current task status"
                  },
                  "activeForm": {
                    "type": "string",
                    "description": [
                      "Present continuous form shown during execution (e.g., 'Fixing authentication bug')",
                      "constraints: minimum length 1"
                    ]
                  }
                },
                "required": [
                  "content",
                  "status",
                  "activeForm"
                ],
                "additionalProperties": false
              },
              "description": "The complete updated task list"
            }
          },
          "required": [
            "tasks"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "task_update",
        "description": [
          "Update one task in the current task list by stable ID. Use this for targeted changes to one existing task.",
          "",
          "Usage:",
          "- Provide the task ID returned by the task-list tools",
          "- Include only the fields that changed",
          "- Use status to move a task between pending, in_progress, and completed",
          "- Use task_complete when only marking a task completed",
          "- If the ID is unknown, the tool returns an error with available task IDs"
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": [
                "Stable task identifier (for example, 'task_investigate_tests'). Keep this unchanged across updates.",
                "constraints: minimum length 1"
              ]
            },
            "content": {
              "description": [
                "New task description in imperative form",
                "constraints: minimum length 1"
              ],
              "type": "string"
            },
            "status": {
              "description": "New task status",
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed"
              ]
            },
            "activeForm": {
              "description": [
                "New present continuous form shown during execution",
                "constraints: minimum length 1"
              ],
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "task_complete",
        "description": [
          "Mark one task completed by stable ID. Use this when one tracked task is finished.",
          "",
          "Usage:",
          "- Provide the task ID returned by the task-list tools",
          "- If the ID is unknown, the tool returns an error with available task IDs"
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": [
                "Stable task identifier (for example, 'task_investigate_tests'). Keep this unchanged across updates.",
                "constraints: minimum length 1"
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "task_check",
        "description": [
          "Check the completion status of your current task list. Use this before finishing tracked work to ensure all tasks are completed.",
          "",
          "Returns:",
          "- Human-readable content summary with task counts and incomplete task IDs",
          "- Structured task list snapshot with stable IDs",
          "- summary object with total, completed, inProgress, pending, incomplete, hasTasks, and allCompleted",
          "- incompleteTasks array for tasks that still need work",
          "",
          "summary.allCompleted is true only when at least one tracked task exists and every tracked task is completed. If no tasks exist, summary.hasTasks is false and summary.allCompleted is false."
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {},
          "additionalProperties": false,
          "required": []
        },
        "eager_input_streaming": true
      },
      {
        "name": "ask_user",
        "description": "Ask the person 1 to 4 questions in one card and wait for their answers. Use it only for what the person alone can decide: a business rule, a company fact or a preference you cannot find in the Project, the web or a sensible default. Never ask what you can look up or choose yourself. Batch every related question into one call. Give a question 2 to 4 `options` when it has likely answers, each a short `label` and an optional `description`. If you recommend one, make it the first option and end its label with \"(recomendado)\". Set `multiSelect: true` when more than one option can be picked. Omit `options` for an open question. Write each question in the person's language. Returns one line per question with the answer.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "description": "constraints: minimum length 1"
                  },
                  "header": {
                    "type": "string",
                    "description": "constraints: minimum length 1, maximum length 12"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "constraints: minimum length 1"
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "multiSelect": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "question"
                ],
                "additionalProperties": false
              },
              "description": "constraints: minimum length 1, maximum length 4"
            }
          },
          "required": [
            "questions"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      }
    ],
    "tool_choice": {
      "type": "auto"
    },
    "stream": true
  }
]