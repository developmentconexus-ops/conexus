      {
        "type": "web_fetch_20250910",
        "name": "web_fetch",
        "citations": {
          "enabled": true
        }
      },
      {
        "name": "conexus_check",
        "description": "Runs Conexus's own check on the app folder: it installs the packages from the lockfile, checks that each operation's input and output fit in JSON and generates the client from them, type checks the screens and the server, builds both and opens the app in a browser inside the machine. The browser opens the entry screen of the app as the Projeto publishes it, on an empty test database and with no connector connected, and the check reports the page errors and the failed requests to the app. Takes no input and returns one result with a `kind`: MACHINE_FAILED (a step failed, so the browser did not run), CONFERENCE_REFUSED (the app did not start or its migrations were refused), NO_ADDRESS (the Projeto has no address to open, so only the steps ran) or SEEN (the browser opened the entry screen: its report is `browser`, CLEAN or DIRTY with the problems, and `shot`, the screenshot you can read with `mastra_workspace_read_file`). `machine` is the report of the steps: `ok` and each step as passed, failed, informed (with its problems: file, line, column, code, message) or skipped after a failed step. Run it at the end of each step of the work, and fix what a failed step or a DIRTY report lists before the next one. If the check could not run, the tool fails with CHECK_PLATFORM_FAILED: it says nothing about the app, so do not change the app because of it. A passing result proves the app type checks, builds and that its entry screen opens with no page error and no failed request. It does not prove that an operation returns the right data, that another screen opens or that anything saves: prove those another way.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {},
          "additionalProperties": false,
          "required": []
        },
        "eager_input_streaming": true
      },
      {
        "type": "web_search_20250305",
        "name": "web_search",
        "user_location": {
          "type": "approximate",
          "country": "BR",
          "timezone": "America/Sao_Paulo"
        }
      },
      {
        "name": "app_data_read",
        "description": "Reads the data of this Projeto’s app with one PostgreSQL SELECT, on its own tables by name, with no schema. List the app’s tables and columns with information_schema.columns where table_schema = current_schema(). One statement only, and it cannot write. A refusal carries PostgreSQL’s SQLSTATE: 42P01 or 42703 is a table or column that does not exist, 42601 a syntax error, 25006 or 42501 a write or a table you cannot read; fix the query and try again. The answer is cut to the first rows. Ask for the columns and rows you need.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "description": "constraints: minimum length 1, maximum length 4000"
            }
          },
          "required": [
            "sql"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "app_data_check",
        "description": "Runs one of the app’s reads on the real data and tells you how many rows it gives, its columns with their types and how long it took, and never a row. Give the SQL and the values of a real case of the handler, exactly as the handler binds them. Use it to prove a read works, not to look at the data: app_data_read shows a few rows for that. A refusal carries PostgreSQL’s SQLSTATE; CHECK_NOT_A_COUNT means the text is not one read.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "description": "constraints: minimum length 1, maximum length 4000"
            },
            "values": {
              "default": [],
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "constraints: maximum length 1000"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": "constraints: maximum length 20"
            }
          },
          "required": [
            "sql"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "data_describe",
        "description": "Lists the company's systems this person may reach, each with the reads it offers. No table of the company's data is kept yet: given a table, it answers NOT_IN_CATALOG.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
