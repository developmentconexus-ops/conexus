{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/starter-components.ts"],
      "project": ["scripts/**/*.ts", "tests/e2e/**/*.ts"],
      "ignoreBinaries": ["openssl"]
    },
    "apps/server": {
      "entry": ["src/**/*.check.ts"],
      "ignoreBinaries": ["setpriv", "mkfifo"]
    },
    "apps/web": {
      "entry": ["src/ui/pieces-fixture.tsx"]
    },
    "packages/app": {
      "entry": ["src/**/*.check.ts"],
      "ignore": ["starter/**"]
    },
    "apps/edge": {
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
