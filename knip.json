{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.ts", "tests/e2e/**/*.ts"],
      "ignoreBinaries": ["openssl", "sha256sum"],
      "ignoreDependencies": ["jscpd"]
    },
    "apps/server": {
      "entry": ["src/**/*.check.ts"],
      "ignoreBinaries": ["setpriv", "mkfifo"],
      "ignoreDependencies": ["@stryker-mutator/command-runner"]
    },
    "apps/web": {
      "entry": ["src/ui/pieces-fixture.tsx"]
    },
    "packages/connectors": {
      "entry": ["scripts/*.ts"]
    },
    "packages/app": {
      "entry": ["src/**/*.check.ts"],
      "ignore": ["starter/**", "skills/**"],
      "ignoreDependencies": [
        "@hookform/resolvers",
        "@tanstack/react-table",
        "date-fns",
        "react-day-picker",
        "recharts"
      ]
    },
    "apps/edge": {
      "entry": ["clone/worker.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
