      },
      {
        "name": "updateWorkingMemory",
        "description": "Update the working memory with new information. Any data not included will be overwritten. Always pass data as string to the memory field. Never pass an object.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "memory": {
              "type": "string",
              "description": "The Markdown formatted working memory content to store. This MUST be a string. Never pass an object."
            }
          },
          "required": [
            "memory"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "recall",
        "description": "Browse conversation history. Use mode=\"threads\" to list all threads for the current user. Use mode=\"messages\" (default) to browse messages in the current thread or pass threadId to browse another thread in the active resource. When mode=\"messages\" has no cursor or threadId, it defaults to the current thread and says so at the top of the result. If you pass only a cursor, it must belong to the current thread.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "messages",
                "threads"
              ],
              "description": "What to retrieve. \"messages\" (default) pages through message history. \"threads\" lists all threads for the current user."
            },
            "threadId": {
              "type": "string",
              "description": [
                "Browse a different thread, or \"current\" for the active thread. Use mode=\"threads\" first to discover thread IDs.",
                "constraints: minimum length 1"
              ]
            },
            "before": {
              "type": "string",
              "description": "Only show results before this date. Applies to mode=\"threads\" (thread creation date) and mode=\"search\" (observation date). ISO 8601 or natural date string (e.g. \"2026-03-15\", \"2026-03-10T00:00:00Z\")."
            },
            "after": {
              "type": "string",
              "description": "Only show results after this date. Applies to mode=\"threads\" (thread creation date) and mode=\"search\" (observation date). ISO 8601 or natural date string (e.g. \"2026-03-01\", \"2026-03-10T00:00:00Z\")."
            },
            "cursor": {
              "type": "string",
              "description": [
                "A message ID to use as the pagination cursor. For mode=\"messages\", omit both cursor and threadId to browse the current thread. If only cursor is provided, it must belong to the current thread. Extract it from the start or end of an observation group range.",
                "constraints: minimum length 1"
              ]
            },
            "anchor": {
              "type": "string",
              "enum": [
                "start",
                "end"
              ],
              "description": "For mode=\"messages\" without a cursor, page from the start (oldest-first) or end (newest-first) of the thread. Defaults to \"start\"."
            },
            "page": {
              "type": "integer",
              "description": [
                "Pagination offset. For messages: positive pages move forward from cursor, negative move backward. For threads: page number (0-indexed). 0 is treated as 1 for messages.",
                "constraints: greater than or equal to -50, lower than or equal to 50"
              ]
            },
            "limit": {
              "type": "integer",
              "description": [
                "Maximum items per page: defaults to 20 for messages, 5 for observations. For search, target number of excerpts (default 10), plus compact references for evidence already in context; bounded backfill may return fewer excerpts.",
                "constraints: greater than or equal to 1, lower than or equal to 20"
              ]
            },
            "detail": {
              "type": "string",
              "enum": [
                "low",
                "high"
              ],
              "description": "Detail level for messages. \"low\" (default) returns truncated text and tool names. \"high\" returns full content with tool args/results."
            },
            "partType": {
              "type": "string",
              "enum": [
                "text",
                "tool-call",
                "tool-result",
                "image",
                "file"
              ],
              "description": "Filter results to only include parts of this type. Only applies to mode=\"messages\"."
            },
            "toolName": {
              "type": "string",
              "description": [
                "Filter results to only include tool-call and tool-result parts matching this tool name. Only applies to mode=\"messages\".",
                "constraints: minimum length 1"
              ]
            },
            "partIndex": {
              "type": "integer",
              "description": [
                "Fetch a single part from the cursor message by its positional index. When provided, returns only that part at high detail. Indices are shown as [p0], [p1], etc. in recall results.",
                "constraints: greater than or equal to 0"
              ]
            },
            "charOffset": {
              "type": "integer",
              "description": [
                "Continue reading a truncated single part from this position. Pass the exact nextCharOffset value returned by a previous call; do not compute it yourself. Only applies with cursor and partIndex in mode=\"messages\".",
                "constraints: greater than or equal to 0"
              ]
            },
            "viewAttachment": {
              "type": "boolean",
              "description": "Show the actual attachment instead of just describing it. Requires cursor and partIndex, and only applies when that part is an image or file. Use it after recall shows you an attachment you need to look at."
            }
          },
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "subagent",
        "description": [
          "Delegate a focused task to a specialized subagent. The subagent runs independently with a constrained toolset, then returns its findings as text.",
          "",
          "Available agent types:",
          "- **pesquisar** (Pesquisa): Reads the company systems chosen in this conversation and the files on its machine to answer one focused question, and returns the findings with where each number came from. Writes nothing.",
          "",
          "By default the subagent runs in its own context — it does NOT see the parent conversation history. Write a clear, self-contained task description.",
          "",
          "Set `forked: true` for context-dependent parallel work that needs the parent conversation, prior tool results, or the parent tool environment. Omit it for self-contained delegation. A forked subagent reuses the parent agent's instructions and tools so the prompt prefix stays cache-friendly.",
          "",
          "Use this tool when:",
          "- You want to run multiple investigations in parallel",
          "- The task is self-contained and can be delegated"
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "agentType": {
              "type": "string",
              "enum": [
                "pesquisar"
              ],
              "description": "Type of subagent to spawn"
            },
            "task": {
              "type": "string",
              "description": "Clear, self-contained description of what the subagent should do. The subagent cannot see this conversation: include all relevant context."
            }
          },
          "required": [
            "agentType",
            "task"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "ask_user",
        "description": "Ask the person 1 to 4 questions in one card and wait for their answers. Use it only for what the person alone can decide: a business rule, a company fact or a preference you cannot find in the Project, the web or a sensible default. Never ask what you can look up or choose yourself. Batch every related question into one call. Give a question 2 to 4 `options` when it has likely answers, each a short `label` and an optional `description`. If you recommend one, make it the first option and end its label with \"(recomendado)\". Set `multiSelect: true` when more than one option can be picked. Omit `options` for an open question. Write each question in the person's language. Returns one line per question with the answer.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "description": "constraints: minimum length 1"
                  },
                  "header": {
                    "type": "string",
                    "description": "constraints: minimum length 1, maximum length 12"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "constraints: minimum length 1"
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "multiSelect": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "question"
                ],
                "additionalProperties": false
              },
              "description": "constraints: minimum length 1, maximum length 4"
            }
          },
          "required": [
            "questions"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_read_file",
        "description": "Read a file from the workspace filesystem. Text files come back as text — use offset/limit to read a line range from large files. Supported media files come back as a native file part you can view directly. Other binary files return only their metadata (path, size, mime type) since their raw contents are not useful to read.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The path to the file to read (e.g., \"data/config.json\")"
            },
            "offset": {
              "description": [
                "Line number to start reading from (1-indexed). Only used when reading text files; ignored for media and other binary files. Defaults to line 1 if omitted.",
                "constraints: greater than or equal to 1"
              ],
              "type": "integer"
            },
            "limit": {
              "description": [
                "Maximum number of lines to read. Only used when reading text files; ignored for media and other binary files. Defaults to the end of the file if omitted.",
                "constraints: greater than or equal to 1"
              ],
              "type": "integer"
            },
            "showLineNumbers": {
              "default": true,
              "description": "Prefix each line with its line number. Only used when reading text files; ignored for media and other binary files. Defaults to true if omitted.",
              "type": "boolean"
            },
            "encoding": {
              "description": "Usually omit this — text files and supported media are handled automatically. Pass `base64` or `hex` to get the file's raw bytes encoded as text when you need to inspect an unsupported binary file that would otherwise only return metadata (e.g. checking a file header or magic bytes).",
              "type": "string",
              "enum": [
                "utf-8",
                "utf8",
                "base64",
                "hex",
                "binary"
              ]
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_write_file",
        "description": "Write content to a file in the workspace filesystem. Creates parent directories if needed.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The path where to write the file (e.g., \"data/output.txt\")"
            },
            "content": {
              "type": "string",
              "description": "The content to write to the file"
            },
            "overwrite": {
              "default": true,
              "description": "Whether to overwrite the file if it already exists",
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_edit_file",
        "description": [
          "Edit a file by replacing specific text. The old_string must match exactly and be unique in the file.",
          "",
          "Usage:",
          "- Read the file first to get the exact text to replace.",
          "- By default, read file output includes line number prefixes (e.g., \"     1→\"). Ensure you preserve the exact indentation as it appears AFTER the arrow. Never include any part of the line number prefix in old_string or new_string.",
          "- Include enough surrounding context (multiple lines) to make old_string unique. If it still isn't unique, include more lines.",
          "- Use replace_all only when intentionally replacing all occurrences."
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The path to the file to edit"
            },
            "old_string": {
              "type": "string",
              "description": "The exact text to find and replace. Must be unique in the file."
            },
            "new_string": {
              "type": "string",
              "description": "The text to replace old_string with"
            },
            "replace_all": {
              "default": false,
              "description": "If true, replace all occurrences. If false (default), old_string must be unique.",
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "old_string",
            "new_string"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_list_files",
        "description": [
          "List files and directories in the workspace filesystem.",
          "Returns a compact tab-indented listing for efficient token usage.",
          "Options mirror common tree command flags for familiarity.",
          "",
          "Examples:",
          "- List workspace root: { path: \".\" }",
          "- Deep listing: { path: \"src\", maxDepth: 5 }",
          "- Directories only: { path: \".\", dirsOnly: true }",
          "- Exclude node_modules: { path: \".\", exclude: \"node_modules\" }",
          "- Find TypeScript files: { path: \"src\", pattern: \"**/*.ts\" }",
          "- Find config files: { path: \".\", pattern: \"*.config.{js,ts}\" }",
          "- Multiple patterns: { path: \".\", pattern: [\"**/*.ts\", \"**/*.tsx\"] }",
          "",
          "To list ALL files, omit the pattern parameter — do NOT pass pattern: \"*\"."
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "default": ".",
              "description": "Directory path to list",
              "type": "string"
            },
            "maxDepth": {
              "default": 2,
              "description": "Maximum depth to descend (default: 2). Similar to tree -L flag.",
              "type": "number"
            },
            "showHidden": {
              "default": false,
              "description": "Show hidden files starting with \".\" (default: false). Similar to tree -a flag.",
              "type": "boolean"
            },
            "dirsOnly": {
              "default": false,
              "description": "List directories only, no files (default: false). Similar to tree -d flag.",
              "type": "boolean"
            },
            "exclude": {
              "description": "Pattern to exclude (e.g., \"node_modules\"). Similar to tree -I flag.",
              "type": "string"
            },
            "extension": {
              "description": "Filter by file extension (e.g., \".ts\"). Similar to tree -P flag.",
              "type": "string"
            },
            "pattern": {
              "description": "Glob pattern(s) to filter files. Omit this parameter to list all files (do NOT pass \"*\"). Use \"**/*.ext\" to match files recursively across directories. \"*\" only matches within a single directory level (standard glob). Glob patterns only filter files — directories are always shown to preserve tree structure. Examples: \"**/*.ts\", \"src/**/*.test.ts\", \"*.config.{js,ts}\".",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "respectGitignore": {
              "default": true,
              "description": "Respect .gitignore in the listed directory (default: true).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_delete",
        "description": "Delete a file or directory from the workspace filesystem",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The path to the file or directory to delete"
            },
            "recursive": {
              "default": false,
              "description": "If true, delete directories and their contents recursively. Required for non-empty directories.",
              "type": "boolean"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_file_stat",
        "description": "Get file or directory metadata from the workspace. Returns existence, type, size, and modification time.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The path to check"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_mkdir",
        "description": "Create a directory in the workspace filesystem",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The path of the directory to create"
            },
            "recursive": {
              "default": true,
              "description": "Whether to create parent directories if they do not exist",
              "type": "boolean"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_grep",
        "description": [
          "Search file contents using a regex pattern. Walks the filesystem and returns matching lines with file paths and line numbers.",
          "",
          "Usage:",
          "- Basic search: { pattern: \"TODO\" }",
          "- Regex: { pattern: \"function\\s+\\w+\\(\" }",
          "- Multiple terms: { pattern: \"TODO|FIXME|HACK\" }",
          "- Case-insensitive: { pattern: \"error\", caseSensitive: false }",
          "- Search in directory: { pattern: \"import\", path: \"./src\" }",
          "- Filter by glob: { pattern: \"import\", path: \"**/*.ts\" }",
          "- Combined path + glob: { pattern: \"import\", path: \"src/**/*.ts\" }",
          "- Multiple file types: { pattern: \"import\", path: \"**/*.{ts,tsx,js}\" }",
          "- Multiple directories: { pattern: \"TODO\", path: \"{src,lib}/**/*.ts\" }",
          "- With context: { pattern: \"function\", contextLines: 2 }"
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Regex pattern to search for"
            },
            "path": {
              "default": ".",
              "description": "File, directory, or glob pattern to search within (default: \".\"). A plain path searches that file or directory. A glob pattern (e.g., \"**/*.ts\", \"src/**/*.test.ts\") filters which files to search.",
              "type": "string"
            },
            "contextLines": {
              "default": 0,
              "description": "Number of lines of context to include before and after each match (default: 0)",
              "type": "number"
            },
            "maxCount": {
              "description": "Maximum matches per file. Moves on to the next file after this many matches. Similar to grep -m flag.",
              "type": "number"
            },
            "caseSensitive": {
              "default": true,
              "description": "Whether the search is case-sensitive (default: true)",
              "type": "boolean"
            },
            "includeHidden": {
              "default": false,
              "description": "Include hidden files and directories (names starting with \".\") in the search (default: false)",
              "type": "boolean"
            }
          },
          "required": [
            "pattern"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_execute_command",
        "description": [
          "Execute a shell command in the workspace sandbox.",
          "",
          "Examples:",
          "  \"npm install && npm run build\"",
          "  \"ls -la src/\"",
          "  \"cat config.json | jq '.database'\"",
          "  \"cd /app && python main.py\"",
          "",
          "Usage:",
          "- Commands run in a shell, so pipes, redirects, and chaining (&&, ||, ;) all work.",
          "- Always quote file paths that contain spaces (e.g., cd \"/path/with spaces\").",
          "- Use the timeout parameter (in seconds) to limit execution time. Behavior when omitted depends on the sandbox provider.",
          "- Optionally use cwd to override the working directory. Commands run from the workspace directory if omitted, the same root relative file paths resolve against; a relative cwd is resolved against that directory.",
          "",
          "Set background: true to run long-running commands (dev servers, watchers) without blocking. You'll get a PID to track the process. On a background command, timeout stops the process after that many seconds: leave it out for dev servers and anything else that should keep running."
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "description": [
                "Short plain-language description of what this command does, shown to the user in place of the raw command (5-10 words, e.g. \"Running the auth unit tests\"). Write it first, before `command` and the other arguments, so the user sees it while the rest of the call streams in. Write it as the next step in an ongoing narrative: it can build on your previous commands implicitly, e.g. after \"Searching open PRs for failing CI\" the next command can be \"Drilling into the first of 15 failures\".",
                "constraints: minimum length 1"
              ]
            },
            "command": {
              "type": "string",
              "description": "The shell command to execute (e.g., \"npm install\", \"ls -la src/\", \"cat file.txt | grep error\")"
            },
            "timeout": {
              "description": "Maximum execution time in seconds. Example: 60 for 1 minute.",
              "type": [
                "number",
                "null"
              ]
            },
            "cwd": {
              "description": "Working directory for the command",
              "type": [
                "string",
                "null"
              ]
            },
            "tail": {
              "description": "For foreground commands: limit output to the last N lines, similar to tail -n. Defaults to 200. Use 0 for no limit.",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "background": {
              "description": "Run the command in the background. Returns a PID immediately instead of waiting for completion. Use get_process_output to check on it later.",
              "type": "boolean"
            }
          },
          "required": [
            "description",
            "command"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_get_process_output",
        "description": [
          "Get the current output (stdout, stderr) and status of a background process by its PID.",
          "",
          "Use this after starting a background command with execute_command (background: true) to check if the process is still running and read its output. Pass waitSeconds to wait for it to finish first."
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "pid": {
              "type": "string",
              "description": "The process ID returned when the background command was started"
            },
            "tail": {
              "description": "Number of lines to return, similar to tail -n. Positive or negative returns last N lines from end. Defaults to 200. Use 0 for no limit.",
              "type": "integer"
            },
            "waitSeconds": {
              "description": [
                "Wait up to this many seconds (max 300) for the process to exit before returning. If it is still running when the wait ends, you get the output so far. Omit to return right away.",
                "constraints: greater than or equal to 1, lower than or equal to 300"
              ],
              "type": "integer"
            }
          },
          "required": [
            "pid"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "mastra_workspace_kill_process",
        "description": [
          "Kill a background process by its PID.",
          "",
          "Use this to stop a long-running background process that was started with execute_command (background: true). Returns the last 50 lines of output."
        ],
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "pid": {
              "type": "string",
              "description": "The process ID of the background process to kill"
            }
          },
          "required": [
            "pid"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "knowledge_list",
        "description": "List the page tree under a starting point: each child with its ref (pass it to knowledge_read or knowledge_list), name and how many children it has. Pass `descriptions: true` to include page descriptions too. Without `from`, lists the scopes this run can read. Use it to find your way around a scope before searching or reading. One result holds at most `limit` entries and about 1,000 tokens of them; when it stops early, `more` says how many entries were left out and gives the `cursor` to list the rest (pass the same `from`).",
        "input_schema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": [
                "Where to start. A page id, a scope address (org:acme), a key path (<scope>#<key>/<child key>, e.g. policy:acme#policies/refund), or an exact page name.",
                "constraints: minimum length 1"
              ]
            },
            "depth": {
              "type": "integer",
              "description": [
                "How many levels below the starting point to list, up to 3. Defaults to 1.",
                "constraints: greater than or equal to 1, lower than or equal to 3"
              ]
            },
            "limit": {
              "type": "integer",
              "description": [
                "Maximum entries. Defaults to 50.",
                "constraints: greater than or equal to 1, lower than or equal to 100"
              ]
            },
            "cursor": {
              "type": "string",
              "description": [
                "The previous result's nextCursor, for the entries after it (pass the same `from`).",
                "constraints: minimum length 1"
              ]
            },
            "descriptions": {
              "type": "boolean",
              "description": "Include each page's description. Off by default; knowledge_read returns a page's description too."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "eager_input_streaming": true
      },
      {
        "name": "knowledge_search",
        "description": "Search the knowledge this run can read: page names, descriptions, bodies and notes. Optional `scope` narrows to pages in those scopes.",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": [
                "What to look for.",
                "constraints: minimum length 1"
              ]
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "constraints: minimum length 1"
              },
              "description": [
                "Only search pages in these scopes (addresses).",
                "constraints: minimum length 1"
              ]
            },
            "limit": {
              "type": "integer",
              "description": [
                "Maximum results. Defaults to 10.",
                "constraints: greater than or equal to 1, lower than or equal to 50"
              ]
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "eager_input_streaming": true
      },
      {
        "name": "knowledge_read",
        "description": "Read a page: its body, its notes, its child pages and the notes on other pages that mention it. Read a scope address (org:acme) to browse that scope. Without `page`, lists the scopes this run holds. When a page's notes, or the notes mentioning it, come to more than 1,000 tokens, a whole read leaves them out and counts them in `more`; read them on their own with `notes` or `mentionedIn`. A body returns at most 1,000 tokens at a time. A body that fits comes whole as `body`; a longer one comes as numbered `lines` (`12│text`) with the `range` they cover, and `more` says where to read on; a first read of a long page shows every heading with its line number and the first lines under it, so you can pick the part to read. For a long page, ask for its `outline` of headings with their line numbers, read one `section`, or `match` terms to see only the lines that contain them, with `context` lines around each. Those part reads return just that part of the body.",
        "input_schema": {
          "type": "object",
          "properties": {
            "page": {
              "type": "string",
              "description": [
                "A page id, a scope address (org:acme), a key path (<scope>#<key>/<child key>, e.g. policy:acme#policies/refund), or an exact page name.",
                "constraints: minimum length 1"
              ]
            },
            "notes": {
              "type": "boolean",
              "description": "Return only the page's notes, however long, without its body."
            },
            "mentionedIn": {
              "type": "boolean",
              "description": "Return only the notes on other pages that mention this page, however long, without its body."
            },
            "cursor": {
              "type": "string",
              "description": [
                "The previous result's nextCursor: returns only the next notes.",
                "constraints: minimum length 1"
              ]
            },
            "mentionedInCursor": {
              "type": "string",
              "description": [
                "The previous result's mentionedInCursor: returns only the next notes that mention this page.",
                "constraints: minimum length 1"
              ]
            },
            "outline": {
              "type": "boolean",
              "description": "Return the body's headings with their sizes in tokens instead of the body."
            },
            "section": {
              "type": "string",
              "description": [
                "Return only the section under this heading (its title, or a unique part of it), subsections included.",
                "constraints: minimum length 1"
              ]
            },
            "match": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "constraints: minimum length 1"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "constraints: minimum length 1"
                  },
                  "description": "constraints: minimum length 1, maximum length 10"
                }
              ],
              "description": "Like grep: return only the lines that contain this term, or any of these terms (case-insensitive), as numbered lines with the range each covers."
            },
            "context": {
              "type": "integer",
              "description": [
                "With `match`: how many lines to show before and after each matching line, like grep -C. Defaults to 2.",
                "constraints: greater than or equal to 0, lower than or equal to 20"
              ]
            },
            "from": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "description": "constraints: greater than or equal to 1"
                },
                "col": {
                  "type": "integer",
                  "description": "constraints: greater than or equal to 0"
                }
              },
              "required": [
                "line"
              ],
              "additionalProperties": false,
              "description": "Where to start reading: a line (counted from 1) and, inside a very long line, a column (counted from 0). The read runs from there to the page's end or the read's token cap, whichever comes first; there is no line count to set. In a section, reads on within it; with `match`, searches from there. `more` gives it when a read stops early."
            },
            "limit": {
              "type": "integer",
              "description": [
                "Maximum notes, children and mentioning notes. Defaults to 10. Not a line count: how much of the body comes back is set by the token cap.",
                "constraints: greater than or equal to 1, lower than or equal to 50"
              ]
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "eager_input_streaming": true
      },
      {
        "name": "skill",
        "description": "Activate a skill to load its full instructions. You should activate skills proactively when they are relevant to the user's request without asking for permission first.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The name or path of the skill to activate. Use the path when multiple skills share the same name."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "skill_search",
        "description": "Search skills by name, description, and content. Use it to find which skill to load with the `skill` tool, or to find specific details inside skills.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "The search query"
            },
            "skillNames": {
              "description": "Optional list of skill names to search within",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "topK": {
              "description": "Maximum number of results to return (default: 5)",
              "type": "number"
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      },
      {
        "name": "skill_read",
        "description": "Read a file from a skill directory (references, scripts, or assets). The path is relative to the skill root.",
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "skillName": {
              "type": "string",
              "description": "The name or path of the skill. Use the path when multiple skills share the same name."
            },
            "path": {
              "type": "string",
              "description": "Path to the file relative to the skill root (e.g. \"references/colors.md\", \"scripts/run.sh\")"
            },
            "startLine": {
              "description": "Starting line number (1-indexed). If omitted, starts from the beginning.",
              "type": "number"
            },
            "endLine": {
              "description": "Ending line number (1-indexed, inclusive). If omitted, reads to the end.",
              "type": "number"
            }
          },
          "required": [
            "skillName",
            "path"
          ],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      }
    ],
    "tool_choice": {
      "type": "auto"
    },
    "stream": true
  }
]