{
  "name": "conexus",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run deps && npm run knip && npm run docs && npm run suppressions && npm run test && npm run build --if-present",
    "lint": "biome check .",
    "typecheck": "tsc -p scripts/tsconfig.json",
    "deps": "depcruise . --config .dependency-cruiser.cjs",
    "knip": "knip",
    "docs": "node scripts/check-docs.ts",
    "suppressions": "node scripts/check-suppressions.ts",
    "approval": "node scripts/check-approval.ts",
    "method-freeze": "node scripts/check-method-freeze.ts",
    "new-dependencies": "node scripts/list-new-dependencies.ts",
    "test": "npm run test:scripts",
    "test:scripts": "node --test --test-timeout=120000 --test-reporter=./scripts/test-reporter.ts scripts/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.4.0",
    "knip": "6.38.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
