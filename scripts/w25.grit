// Revalidate by 2027-04-15, or when Tailwind changes how a width utility resolves its namespace.
or {
  JsStringLiteralExpression() as $text,
  JsxString() as $text,
  JsTemplateChunkElement() as $text
} where {
  $text <: r".*\b(?:max-w|min-w|w)-(?:xs|sm|md|lg|xl|2xl)\b.*",
  register_diagnostic(span=$text, message="A width utility with a brand spacing name reads --spacing-*, not --container-*: use a --container-* token with a name of its own (web W25).")
}
