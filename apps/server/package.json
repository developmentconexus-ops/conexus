{
  "name": "@conexus/server",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "npm run build",
    "start": "node src/main.ts",
    "build": "esbuild src/hub/identity/invitation-email.tsx --bundle --platform=node --format=esm --minify --define:process.env.NODE_ENV='\"production\"' --jsx=automatic --alias:react=./node_modules/react --alias:react-dom=./node_modules/react-dom --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=src/hub/identity/invitation-render.mjs",
    "pretest": "npm run build",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 --test-reporter=../../scripts/test-reporter.ts $(node ../../scripts/server-shards.ts ${TEST_SHARD:-all})"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.133",
    "@aws-sdk/client-s3": "3.1146.0",
    "@better-auth/core": "1.7.8",
    "@better-auth/drizzle-adapter": "1.7.8",
    "@conexus/hub-api": "*",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.5",
    "@mastra/core": "1.78.0",
    "@mastra/e2b": "0.14.1",
    "@mastra/memory": "1.38.0",
    "@mastra/pg": "1.31.2",
    "@neon/sdk": "7.3.0",
    "@neondatabase/serverless": "1.2.0",
    "ai": "6.0.309",
    "better-auth": "1.7.8",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "1.0.0-rc.4",
    "e2b": "2.56.0",
    "fastify": "5.12.5",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mastra/evals": "1.10.7",
    "@react-email/render": "2.1.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.28.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.11.0"
  }
}
