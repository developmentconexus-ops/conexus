// The app every Projeto runs until step 9, uploaded to the namespace with --dispatch-namespace.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "conexus-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
