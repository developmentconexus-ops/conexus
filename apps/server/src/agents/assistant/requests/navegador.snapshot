[
  {
    "type": "tool_use",
    "id": "toolu_<id-1>",
    "name": "mastra_workspace_execute_command",
    "input": {
      "command": "'agent-browser' open 'http://<site>/' && 'agent-browser' wait --load networkidle && mkdir -p shots && 'agent-browser' screenshot \"$PWD/shots/padaria.png\"",
      "description": "Rodando um teste"
    }
  },
  {
    "type": "tool_use",
    "id": "toolu_<id-2>",
    "name": "mastra_workspace_read_file",
    "input": {
      "path": "shots/padaria.png"
    }
  },
  {
    "type": "tool_result",
    "tool_use_id": "toolu_<id-2>",
    "content": [
      {
        "type": "text",
        "text": "/shots/padaria.png (<bytes>, image/png)"
      },
      {
        "type": "image",
        "source": {
          "type": "base64",
          "media_type": "image/png",
          "data": "<png>"
        }
      }
    ]
  },
  {
    "type": "tool_use",
    "id": "toolu_<id-3>",
    "name": "show_file",
    "input": {
      "path": "shots/padaria.png"
    }
  },
  {
    "type": "tool_result",
    "tool_use_id": "toolu_<id-3>",
    "content": "{\"shown\":\"<folder>/work/shots/padaria.png\"}",
    "cache_control": {
      "type": "ephemeral",
      "ttl": "1h"
    }
  }
]