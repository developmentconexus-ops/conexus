{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.ts", "tests/e2e/**/*.ts"],
      "ignoreBinaries": ["openssl"],
      "ignoreDependencies": ["jscpd", "agent-browser"]
    },
    "apps/server": {
      "entry": ["src/**/*.check.ts"],
      "ignoreBinaries": ["setpriv", "mkfifo"],
      "ignoreDependencies": ["@stryker-mutator/command-runner"]
    },
    "apps/web": {
      "entry": [
        "src/ui/pieces-fixture.tsx",
        "src/harness/room/diagram-fixture.tsx",
        "src/harness/room/diagram-frame.ts"
      ]
    },
    "packages/connectors": {
      "entry": ["scripts/*.ts"]
    },
    "packages/app": {
      "entry": ["src/**/*.check.ts", "src/check/program.ts"],
      "ignore": ["starter/**", "skills/**"],
      "ignoreDependencies": [
        "@hookform/resolvers",
        "@tanstack/react-table",
        "date-fns",
        "react-day-picker",
        "recharts"
      ]
    },
    "infra/aws": {
      "entry": ["bin/app.ts", "test/**/*.test.ts"]
    },
    "apps/edge": {
      "entry": ["clone/worker.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
